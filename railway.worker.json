{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": { "preDeployCommand": ["pnpm --filter @repo/worker migrate"], "startCommand": "pnpm --filter @repo/worker start", "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3 }
}
