# Web + worker. Generate locally using: openssl rand -base64 32
DATABASE_URL=
CREDENTIAL_ENCRYPTION_KEY=
APP_ORIGIN=https://your-studio.up.railway.app
DAYTONA_SNAPSHOT=screen-studio-pw-1-64-1-v1
ALLOWED_TARGET_ORIGINS=https://kraftybot.app
# Worker only. Add exact identity/CDN origins observed on the approved website.
# A leading "*." label allows hostnames minted per visitor (Clerk Protect).
DAYTONA_API_KEY=
# Worker only. Direct Anthropic API billing uses credits in the key's organization.
# Explicit opt-in: without it the existing scripted capture flow is preserved.
CLAUDE_NAVIGATION=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
BROWSER_ALLOWED_ORIGINS=https://kraftybot.app,https://clerk.kraftybot.app,https://img.clerk.com,https://api.trigger.dev,https://cdn.protect.clerk.com,https://*.client.protect.clerk.com
# Private S3-compatible storage. Web signs short-lived downloads, worker uploads.
S3_ENDPOINT=
S3_REGION=auto
# Railway's current buckets require virtual-host addressing; set false there.
S3_FORCE_PATH_STYLE=true
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
