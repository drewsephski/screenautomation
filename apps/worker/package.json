{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "bundle": "node scripts/bundle.mjs",
    "start": "node src/service.ts",
    "migrate": "node src/migrate.ts",
    "provider:check": "node --env-file-if-exists=../../.env.local scripts/provider-check.mjs",
    "provider:check-failure": "node --env-file-if-exists=../../.env.local scripts/capture-failure-check.mjs",
    "provider:check-network": "node --env-file-if-exists=../../.env.local scripts/network-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "@aws-sdk/client-s3": "3.1016.0",
    "@aws-sdk/s3-request-presigner": "3.1016.0",
    "@daytonaio/sdk": "0.226.0",
    "@repo/browser": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/jobs": "workspace:*",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
